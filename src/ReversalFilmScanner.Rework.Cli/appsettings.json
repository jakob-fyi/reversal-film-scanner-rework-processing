{
  "Processing": {
    "InputDirectory": "",
    "FileExtension": "jpg",
    "Rename": true,
    "RenamePrefix": "Prefix_",
    "RenameStartIndex": 1,
    "RenameNumberFormat": "000000",
    "Crop": true,
    "Rotate180": true,
    "FlipHorizontal": false,
    "JpegQuality": 100
  },
  "ScanLayout": {
    "LeftProbe": { "X": 1070, "Y": 700, "Width": 600, "Height": 2500 },
    "RightProbe": { "X": 4170, "Y": 700, "Width": 600, "Height": 2500 },
    "BlackRgbSumThreshold": 45,
    "PortraitBlackPercentageThreshold": 95,
    "PortraitCrop": { "X": 1800, "Y": 170, "Width": 2270, "Height": 3540 },
    "LandscapeCrop": { "X": 1170, "Y": 800, "Width": 3540, "Height": 2270 }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
